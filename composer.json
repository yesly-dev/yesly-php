{
    "name": "yesly/yesly-php",
    "description": "Official PHP library for the Yesly API",
    "type": "library",
    "license": "MIT",
    "homepage": "https://yesly.dev",
    "keywords": ["yesly", "agents", "conversations", "whatsapp", "sms", "api"],
    "require": {
        "php": ">=8.1",
        "ext-curl": "*",
        "ext-json": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5 || ^11.0 || ^12.0 || ^13.0",
        "phpstan/phpstan": "^2.1"
    },
    "autoload": {
        "psr-4": {
            "Yesly\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Yesly\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "generate": "node ../yesly-openapi/sdk/generate.mjs php .",
        "test": "phpunit",
        "analyse": "phpstan analyse --level=8 src"
    },
    "config": {
        "sort-packages": true
    }
}
